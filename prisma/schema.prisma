generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                  String                  @id @default(uuid())
  userName            String
  loginId             String                  @unique
  email               String                  @unique
  passwordHash        String
  cellNo              String?
  imageUrl            String?
  roleId              String?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime?               @updatedAt
  notificationTargets AppNotificationTarget[]
  role                AppRole?                @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]
  consultantProfile   ConsultantProfile?
  creditBalances      CreditBalance?
  customerProfile     CustomerProfile?
  externalLogins      ExternalLogin[]
  invoices            Invoice[]
  sentMessages        Message[]
  passwordResetTokens PasswordResetToken[]
  paymentTransactions PaymentTransaction[]
  refreshTokens       RefreshToken[]

  permissions UserPermission[]
  pushTokens  WebPushToken[]
}

model ExternalLogin {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerKey String
  email       String?
  displayName String?
  avatarUrl   String?
  linkedAt    DateTime @default(now())
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerKey])
}

model AppRole {
  id                        String           @id @default(uuid())
  roleName                  String
  createdOn                 DateTime         @default(now())
  users                     AppUser[]
  clientDefaultSettings     ClientSettings[] @relation("ClientDefaultRole")
  consultantDefaultSettings ClientSettings[] @relation("ConsultantDefaultRole")
  menuEntries               RoleMenuEntry[]
  modules                   RoleModule[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerProfile {
  id            String             @id @default(uuid())
  userId        String             @unique
  avatarUrl     String?
  bio           String?
  companyName   String?
  industry      String?
  cityName      String?
  isActive      Boolean            @default(true)
  joinedDate    DateTime           @default(now())
  updatedAt     DateTime?          @updatedAt
  connections   ClientConnection[]
  reviews       ConsultantReview[]
  conversations Conversation[]
  user          AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsultantProfile {
  id             String                   @id @default(uuid())
  userId         String                   @unique
  slug           String                   @unique
  bio            String?
  isOnline       Boolean                  @default(false)
  isPublic       Boolean                  @default(true)
  joinedDate     DateTime                 @default(now())
  updatedAt      DateTime?                @updatedAt
  specialization String?
  experience     String?
  hourlyRate     Float?
  timezone       String?
  avatarUrl      String?
  connections    ClientConnection[]
  availabilities ConsultantAvailability[]
  user           AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        ConsultantReview[]
  serviceConfig  ConsultantServiceConfig?
  conversations  Conversation[]
}

model ConsultantReview {
  id           String            @id @default(uuid())
  consultantId String
  customerId   String
  rating       Int
  comment      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime?         @updatedAt
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id])
  customer     CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([consultantId, customerId])
}

model ConsultantAvailability {
  id           String            @id @default(uuid())
  consultantId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  isActive     Boolean           @default(true)
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
}

model ClientConnection {
  id           String            @id @default(uuid())
  consultantId String
  customerId   String
  status       String            @default("Pending")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime?         @updatedAt
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id])
  customer     CustomerProfile   @relation(fields: [customerId], references: [id])

  @@index([consultantId, customerId])
}

model Conversation {
  id            String            @id @default(uuid())
  consultantId  String
  customerId    String
  createdAt     DateTime          @default(now())
  lastMessageAt DateTime          @default(now())
  consultant    ConsultantProfile @relation(fields: [consultantId], references: [id])
  customer      CustomerProfile   @relation(fields: [customerId], references: [id])
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  messageType    String       @default("text")
  attachmentUrl  String?
  replyToId      String?
  sentAt         DateTime     @default(now())
  isRead         Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         AppUser      @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([sentAt])
}

model CreditBalance {
  id           String              @id @default(uuid())
  userId       String              @unique
  amount       Float               @default(0)
  updatedAt    DateTime            @updatedAt
  user         AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id              String              @id @default(uuid())
  creditBalanceId String
  amount          Float
  type            String
  description     String?
  paymentId       String?
  createdAt       DateTime            @default(now())
  balance         CreditBalance       @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)
  payment         PaymentTransaction? @relation(fields: [paymentId], references: [id])

  @@index([createdAt])
}

model PaymentTransaction {
  id                 String              @id @default(uuid())
  userId             String
  amount             Float
  currency           String
  status             String              @default("Pending")
  provider           String
  transactionRef     String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditTransactions CreditTransaction[]
  invoices           Invoice[]
  user               AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessagePricing {
  id           String  @id @default(uuid())
  messageType  String  @unique
  unitType     String
  unitSize     Int
  pricePerUnit Float
  currency     String
  description  String?
}

model ConsultantServiceConfig {
  id                String            @id @default(uuid())
  consultantUserId  String            @unique
  textRate          Float             @default(0)
  audioRate         Float             @default(0)
  videoRate         Float             @default(0)
  imageRate         Float             @default(0)
  fileRate          Float             @default(0)
  stripeEnabled     Boolean           @default(false)
  stripeAccountId   String?
  jazzCashEnabled   Boolean           @default(false)
  jazzCashAccount   String?
  easyPaisaEnabled  Boolean           @default(false)
  easyPaisaAccount  String?
  payFastEnabled    Boolean           @default(false)
  payFastMerchantId String?
  payFastSecuredKey String?
  voiceEnabled      Boolean           @default(false)
  videoEnabled      Boolean           @default(false)
  consultant        ConsultantProfile @relation(fields: [consultantUserId], references: [userId], onDelete: Cascade)
}

model Invoice {
  id            String             @id @default(uuid())
  userId        String
  paymentId     String
  invoiceNumber String             @unique
  subTotal      Float
  tax           Float
  total         Float
  status        String             @default("Paid")
  createdAt     DateTime           @default(now())
  payment       PaymentTransaction @relation(fields: [paymentId], references: [id])
  user          AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorLog {
  id         String   @id @default(uuid())
  message    String
  stackTrace String?
  source     String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String
  createdOn DateTime @default(now())
  user      AppUser? @relation(fields: [userId], references: [id])

  @@index([createdOn])
  @@index([userId])
}

model Configuration {
  key   String @id
  value String
}

model WebPushToken {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ControlType {
  id                String            @id @default(uuid())
  controlTypeName   String
  controlTypePrefix String
  createdOn         DateTime          @default(now())
  categories        ControlCategory[]
}

model ControlCategory {
  id                  String      @id @default(uuid())
  controlTypeId       String
  controlCategoryName String
  controlPrefix       String
  createdOn           DateTime    @default(now())
  controlType         ControlType @relation(fields: [controlTypeId], references: [id], onDelete: Cascade)
}

model ClientArea {
  id                String   @id @default(uuid())
  controlAreaName   String
  controlAreaPrefix String
  createdOn         DateTime @default(now())
}

model ClientCategory {
  id                    String   @id @default(uuid())
  controlCategoryName   String
  controlCategoryPrefix String
  createdOn             DateTime @default(now())
}

model DocumentType {
  id               String   @id @default(uuid())
  documentTypeName String
  shortName        String
  createdOn        DateTime @default(now())
}

model DocumentMovement {
  id String @id @default(uuid())
}

model CriteriaType {
  id                 String            @id @default(uuid())
  criteriaTypeName   String
  criteriaTypePrefix String
  createdOn          DateTime          @default(now())
  subTypes           CriteriaSubType[]
}

model CriteriaSubType {
  id              String       @id @default(uuid())
  criteriaTypeId  String
  subCriteriaName String
  prefix          String
  createdOn       DateTime     @default(now())
  criteriaType    CriteriaType @relation(fields: [criteriaTypeId], references: [id], onDelete: Cascade)
}

model Currency {
  id           String   @id @default(uuid())
  countryName  String
  currencyName String
  symbol       String
  createdOn    DateTime @default(now())
}

model Country {
  id          String     @id @default(uuid())
  countryName String
  code        String
  prefix      String
  createdOn   DateTime   @default(now())
  provinces   Province[]
}

model Province {
  id           String   @id @default(uuid())
  countryId    String
  provinceName String
  prefix       String
  createdOn    DateTime @default(now())
  cities       City[]
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

model City {
  id         String     @id @default(uuid())
  provinceId String
  cityName   String
  createdOn  DateTime   @default(now())
  areas      Area[]
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts  District[]
}

model District {
  id           String   @id @default(uuid())
  cityId       String
  districtName String
  createdOn    DateTime @default(now())
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tehsils      Tehsil[]
}

model Tehsil {
  id         String   @id @default(uuid())
  districtId String
  tehsilName String
  createdOn  DateTime @default(now())
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
}

model Area {
  id        String   @id @default(uuid())
  cityId    String
  areaName  String
  createdOn DateTime @default(now())
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model Organization {
  id             String   @id @default(uuid())
  clientName     String
  clientArea     String
  clientGroup    String
  currency       String
  currencySymbol String
  email          String
  contactPerson  String
  cellNo         String
  website        String
  ntn            String
  strn           String
  updatedAt      DateTime @updatedAt
}

model RoleModule {
  id         String  @id @default(uuid())
  roleId     String
  moduleName String
  role       AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model RoleMenuEntry {
  id       String  @id @default(uuid())
  roleId   String
  menuName String
  role     AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model UserPermission {
  id         String  @id @default(uuid())
  userId     String
  permission String
  user       AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WaTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}

model SmsTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  content   String
  createdAt DateTime @default(now())
}

model WebTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}

model WaNotification {
  id     String    @id @default(uuid())
  to     String
  body   String
  status String
  sentAt DateTime?
}

model SmsNotification {
  id     String    @id @default(uuid())
  to     String
  body   String
  status String
  sentAt DateTime?
}

model EmailNotification {
  id      String    @id @default(uuid())
  to      String
  subject String
  body    String
  status  String
  sentAt  DateTime?
}

model WebNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppNotification {
  id        String                  @id @default(uuid())
  title     String
  body      String
  createdAt DateTime                @default(now())
  targets   AppNotificationTarget[]
}

model AppNotificationTarget {
  id             String          @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean         @default(false)
  readAt         DateTime?
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientSettings {
  id                      String   @id @default(uuid())
  isWebsiteOnline         Boolean  @default(true)
  footerDescription       String?
  businessName            String
  businessNature          String
  businessProvince        String
  fbrToken                String?
  validationToken         String?
  consultantDefaultRoleId String?
  clientDefaultRoleId     String?
  chatLinkUrl             String?
  updatedAt               DateTime @updatedAt
  clientDefaultRole       AppRole? @relation("ClientDefaultRole", fields: [clientDefaultRoleId], references: [id])
  consultantDefaultRole   AppRole? @relation("ConsultantDefaultRole", fields: [consultantDefaultRoleId], references: [id])
}

